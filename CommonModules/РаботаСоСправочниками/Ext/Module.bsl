#Область ПрограммныйИнтерфейс

// Возвращает розничную цену номенклатуры на дату (книга Радченко, занятие 12).
// Берет последнее значение периодического регистра сведений "Цены"
// на дату АктуальнаяДата (срез последних).
//
// Параметры:
//  АктуальнаяДата      - Дата - дата, на которую нужна цена (обычно дата документа);
//  ЭлементНоменклатуры - СправочникСсылка.Номенклатура.
//
// Возвращаемое значение:
//  Число - цена; 0, если цена не задана.
//
Функция РозничнаяЦена(АктуальнаяДата, ЭлементНоменклатуры) Экспорт

	Отбор = Новый Структура("Номенклатура", ЭлементНоменклатуры);
	ЗначенияРесурсов = РегистрыСведений.Цены.ПолучитьПоследнее(АктуальнаяДата, Отбор);
	Возврат ЗначенияРесурсов.Цена;

КонецФункции

// Возвращает розничные цены сразу для списка номенклатуры на дату -
// ОДИН серверный вызов и ОДИН запрос к срезу последних регистра "Цены"
// (используется при подборе нескольких позиций, замечание наставника по неделе 5).
//
// Параметры:
//  АктуальнаяДата     - Дата - дата, на которую нужны цены;
//  МассивНоменклатуры - Массив из СправочникСсылка.Номенклатура.
//
// Возвращаемое значение:
//  Соответствие - ключ: номенклатура, значение: Число (цена). Нет цены - нет ключа.
//
Функция РозничныеЦены(АктуальнаяДата, МассивНоменклатуры) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Цены.Номенклатура КАК Номенклатура,
	|	Цены.Цена КАК Цена
	|ИЗ
	|	РегистрСведений.Цены.СрезПоследних(&АктуальнаяДата, Номенклатура В (&МассивНоменклатуры)) КАК Цены";
	Запрос.УстановитьПараметр("АктуальнаяДата", АктуальнаяДата);
	Запрос.УстановитьПараметр("МассивНоменклатуры", МассивНоменклатуры);

	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Номенклатура, Выборка.Цена);
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти
