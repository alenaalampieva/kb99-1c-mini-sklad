#Область ПрограммныйИнтерфейс

// Обработчик регламентного задания "КонтрольОстатков" (неделя 5).
// Раз в сутки проверяет остатки товаров (услуги и группы не проверяются)
// и пишет в журнал регистрации предупреждение по каждому товару,
// остаток которого меньше минимального (включая нулевые и отрицательные).
// Итог проверки - отдельной информационной записью.
Процедура КонтрольОстатков() Экспорт
	
	МинимальныйОстаток = 2;
	
	Запрос = Новый Запрос;
	// Псевдоним таблицы справочника - Спр (не "Номенклатура"),
	// иначе поле Спр.ЭтоГруппа неоднозначно с полем Остатки.Номенклатура
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Спр.Ссылка КАК Товар,
	|	ЕСТЬNULL(Остатки.КоличествоОстаток, 0) КАК Остаток
	|ИЗ
	|	Справочник.Номенклатура КАК Спр
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиНоменклатуры.Остатки(, ) КАК Остатки
	|		ПО Спр.Ссылка = Остатки.Номенклатура
	|ГДЕ
	|	НЕ Спр.ЭтоГруппа
	|	И НЕ Спр.ПометкаУдаления
	|	И НЕ Спр.Родитель.Наименование ПОДОБНО ""%слуг%""
	|	И НЕ Спр.Родитель.Родитель.Наименование ПОДОБНО ""%слуг%""
	|	И ЕСТЬNULL(Остатки.КоличествоОстаток, 0) < &МинимальныйОстаток
	|
	|УПОРЯДОЧИТЬ ПО
	|	Остаток";
	Запрос.УстановитьПараметр("МинимальныйОстаток", МинимальныйОстаток);
	
	Выборка = Запрос.Выполнить().Выбрать();
	КоличествоТоваров = 0;
	
	Пока Выборка.Следующий() Цикл
		КоличествоТоваров = КоличествоТоваров + 1;
		ЗаписьЖурналаРегистрации("КонтрольОстатков",
			УровеньЖурналаРегистрации.Предупреждение,
			Метаданные.РегистрыНакопления.ОстаткиНоменклатуры,
			Выборка.Товар,
			СтрШаблон("Заканчивается товар: %1, остаток %2. Нужно дозаказать.",
				Выборка.Товар, Выборка.Остаток));
	КонецЦикла;
	
	ЗаписьЖурналаРегистрации("КонтрольОстатков",
		УровеньЖурналаРегистрации.Информация, , ,
		СтрШаблон("Проверка остатков завершена. Товаров с остатком меньше %1: %2",
			МинимальныйОстаток, КоличествоТоваров));
	
КонецПроцедуры

#КонецОбласти
