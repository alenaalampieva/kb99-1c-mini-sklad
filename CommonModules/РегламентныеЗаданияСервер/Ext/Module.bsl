#Область ПрограммныйИнтерфейс

// Обработчик регламентного задания "КонтрольОстатков".
// Неделя 5: проверка остатков с записью в журнал регистрации.
// Неделя 6 (замечания наставника): задание периодически ОБНОВЛЯЕТ служебный справочник
// "Товары к дозаказу" - в нем всегда актуальный список товаров с остатком меньше минимального:
//  - товар стал "дефицитным" - создаем элемент;
//  - уже есть в справочнике - обновляем остаток и дату;
//  - остаток восстановился - удаляем элемент из справочника.
// Все данные берутся ОДНИМ запросом (без запросов и обращений через точку в цикле).
Процедура КонтрольОстатков() Экспорт

	МинимальныйОстаток = 2;
	ДатаОбновления = ТекущаяДатаСеанса();

	Запрос = Новый Запрос;
	// Псевдоним таблицы справочника - Спр (не "Номенклатура"), иначе поле ЭтоГруппа неоднозначно.
	// ЕСТЬNULL для родителей: у товаров верхнего уровня Родитель пустой, и без ЕСТЬNULL
	// условие "НЕ ... ПОДОБНО" давало бы NULL - такие товары молча выпадали из проверки.
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Спр.Ссылка КАК Товар,
	|	ПРЕДСТАВЛЕНИЕ(Спр.Ссылка) КАК ТоварПредставление,
	|	ЕСТЬNULL(Остатки.КоличествоОстаток, 0) КАК Остаток
	|ПОМЕСТИТЬ ВТ_Дефицит
	|ИЗ
	|	Справочник.Номенклатура КАК Спр
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиНоменклатуры.Остатки(, ) КАК Остатки
	|		ПО Спр.Ссылка = Остатки.Номенклатура
	|ГДЕ
	|	НЕ Спр.ЭтоГруппа
	|	И НЕ Спр.ПометкаУдаления
	|	И НЕ ЕСТЬNULL(Спр.Родитель.Наименование, """") ПОДОБНО ""%слуг%""
	|	И НЕ ЕСТЬNULL(Спр.Родитель.Родитель.Наименование, """") ПОДОБНО ""%слуг%""
	|	И ЕСТЬNULL(Остатки.КоличествоОстаток, 0) < &МинимальныйОстаток
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// Товары с дефицитом + уже существующий элемент служебного справочника (если есть)
	|ВЫБРАТЬ
	|	ВТ_Дефицит.Товар КАК Товар,
	|	ВТ_Дефицит.ТоварПредставление КАК ТоварПредставление,
	|	ВТ_Дефицит.Остаток КАК Остаток,
	|	ТоварыКДозаказу.Ссылка КАК ЭлементСправочника
	|ИЗ
	|	ВТ_Дефицит КАК ВТ_Дефицит
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ТоварыКДозаказу КАК ТоварыКДозаказу
	|		ПО ВТ_Дефицит.Товар = ТоварыКДозаказу.Номенклатура
	|
	|УПОРЯДОЧИТЬ ПО
	|	Остаток
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// Элементы справочника, товары которых больше не в дефиците - их удаляем
	|ВЫБРАТЬ
	|	ТоварыКДозаказу.Ссылка КАК ЭлементСправочника
	|ИЗ
	|	Справочник.ТоварыКДозаказу КАК ТоварыКДозаказу
	|ГДЕ
	|	НЕ ТоварыКДозаказу.Номенклатура В
	|				(ВЫБРАТЬ
	|					ВТ_Дефицит.Товар
	|				ИЗ
	|					ВТ_Дефицит)";
	Запрос.УстановитьПараметр("МинимальныйОстаток", МинимальныйОстаток);

	Результаты = Запрос.ВыполнитьПакет();
	ВыборкаДефицит = Результаты[1].Выбрать();
	ВыборкаЛишние = Результаты[2].Выбрать();

	Создано = 0;
	Обновлено = 0;
	Удалено = 0;

	НачатьТранзакцию();
	Попытка

		Пока ВыборкаДефицит.Следующий() Цикл

			Если ЗначениеЗаполнено(ВыборкаДефицит.ЭлементСправочника) Тогда
				ЭлементОбъект = ВыборкаДефицит.ЭлементСправочника.ПолучитьОбъект();
				Обновлено = Обновлено + 1;
			Иначе
				ЭлементОбъект = Справочники.ТоварыКДозаказу.СоздатьЭлемент();
				ЭлементОбъект.Номенклатура = ВыборкаДефицит.Товар;
				Создано = Создано + 1;
			КонецЕсли;
			ЭлементОбъект.Наименование = ВыборкаДефицит.ТоварПредставление;
			ЭлементОбъект.Остаток = ВыборкаДефицит.Остаток;
			ЭлементОбъект.ДатаОбновления = ДатаОбновления;
			ЭлементОбъект.Записать();

			ЗаписьЖурналаРегистрации("КонтрольОстатков", УровеньЖурналаРегистрации.Предупреждение,
				Метаданные.РегистрыНакопления.ОстаткиНоменклатуры, ВыборкаДефицит.Товар,
				СтрШаблон(НСтр("ru = 'Заканчивается товар: %1, остаток %2. Нужно дозаказать.'"),
					ВыборкаДефицит.ТоварПредставление, ВыборкаДефицит.Остаток));

		КонецЦикла;

		// Справочник служебный, ссылок на его элементы нет - удаляем сразу, без пометки.
		Пока ВыборкаЛишние.Следующий() Цикл
			ВыборкаЛишние.ЭлементСправочника.ПолучитьОбъект().Удалить();
			Удалено = Удалено + 1;
		КонецЦикла;

		ЗафиксироватьТранзакцию();

	Исключение
		ОтменитьТранзакцию();
		ЗаписьЖурналаРегистрации("КонтрольОстатков", УровеньЖурналаРегистрации.Ошибка, , ,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение;
	КонецПопытки;

	ЗаписьЖурналаРегистрации("КонтрольОстатков", УровеньЖурналаРегистрации.Информация, , ,
		СтрШаблон(НСтр("ru = 'Справочник ""Товары к дозаказу"" обновлен (остаток меньше %1): добавлено %2, обновлено %3, удалено %4.'"),
			МинимальныйОстаток, Создано, Обновлено, Удалено));

КонецПроцедуры

#КонецОбласти
