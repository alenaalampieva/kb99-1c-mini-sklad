                                                               // Внешняя печатная форма «Акт о списании товаров (кв99)» для документа
// «Списание недостач товаров» (УТ 11, БСП). Неделя 5, Алампиева.
//
// Как устроено:
//  1. СведенияОВнешнейОбработке() - «паспорт» для БСП: вид, назначение, команды.
//  2. Печать(...) - вызывается БСП на сервере, формирует табличный документ.
//  3. Макет: если в обработке нарисован макет «Макет» - берётся он (ПолучитьМакет),
//     иначе макет с теми же именованными областями строится программно.

#Область ПрограммныйИнтерфейс

// Паспорт внешней обработки для подсистемы «Дополнительные отчеты и обработки».
Функция СведенияОВнешнейОбработке() Экспорт
	
	ПараметрыРегистрации = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке("2.3.1.73");
	
	ПараметрыРегистрации.Вид = ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиПечатнаяФорма();
	ПараметрыРегистрации.Версия = "1.0";
	ПараметрыРегистрации.Наименование = "Акт о списании товаров (кв99)";
	ПараметрыРегистрации.Информация = "Печатная форма акта о списании товаров с причиной списания. Неделя 5 курса kb99.";
	ПараметрыРегистрации.БезопасныйРежим = Ложь; // нужен для картинки штрихкода
	
	// К какому документу привязана команда «Печать»
	ПараметрыРегистрации.Назначение.Добавить("Документ.СписаниеНедостачТоваров");
	
	// Команда печати
	Команда = ПараметрыРегистрации.Команды.Добавить();
	Команда.Представление = "Акт о списании товаров (кв99)";
	Команда.Идентификатор = "АктОСписании";
	Команда.Использование = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыВызовСерверногоМетода();
	Команда.Модификатор = "ПечатьMXL";
	Команда.ПоказыватьОповещение = Ложь;
	
	Возврат ПараметрыРегистрации;
	
КонецФункции

// Вызывается БСП при выборе команды печати.
Процедура Печать(МассивОбъектов, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	ПечатнаяФорма = УправлениеПечатью.СведенияОПечатнойФорме(КоллекцияПечатныхФорм, "АктОСписании");
	Если ПечатнаяФорма <> Неопределено Тогда
		ПечатнаяФорма.ТабличныйДокумент = СформироватьАкт(МассивОбъектов, ОбъектыПечати);
		ПечатнаяФорма.СинонимМакета = "Акт о списании товаров (кв99)";
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СформироватьАкт(МассивОбъектов, ОбъектыПечати)
	
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.КлючПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_АктОСписании_кв99";
	ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабДок.АвтоМасштаб = Истина;
	
	Макет = ПолучитьМакетАкта();
	
	Для Каждого ДокументСсылка Из МассивОбъектов Цикл
		
		// Каждый акт - с новой страницы (кроме первого)
		Если ТабДок.ВысотаТаблицы > 0 Тогда
			ТабДок.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		НомерСтрокиНачало = ТабДок.ВысотаТаблицы + 1;
		
		Док = ДокументСсылка.ПолучитьОбъект();
		МетаДок = Док.Метаданные();
		
		// --- Штрихкод (пустые строки, сверху кладём картинку)
		ОбластьШК = Макет.ПолучитьОбласть("Штрихкод");
		ТабДок.Вывести(ОбластьШК);
		ВывестиШтрихкод(ТабДок, ДокументСсылка, НомерСтрокиНачало);
		
		// --- Заголовок
		Область = Макет.ПолучитьОбласть("Заголовок");
		Область.Параметры.ТекстЗаголовка = СтрШаблон("Акт о списании товаров № %1 от %2",
			НомерНаПечать(Док.Номер), Формат(Док.Дата, "ДЛФ=DD"));
		ТабДок.Вывести(Область);
		
		// --- Шапка
		Область = Макет.ПолучитьОбласть("Шапка");
		Область.Параметры.Организация   = ЗначениеРеквизита(Док, МетаДок, "Организация");
		Область.Параметры.Подразделение = ЗначениеРеквизита(Док, МетаДок, "Подразделение");
		Область.Параметры.Склад         = ЗначениеРеквизита(Док, МетаДок, "Склад");
		ТабДок.Вывести(Область);
		
		// --- Таблица товаров
		ТабДок.Вывести(Макет.ПолучитьОбласть("ШапкаТаблицы"));
		ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
		НомерСтроки = 0;
		Для Каждого СтрокаТЧ Из Док.Товары Цикл
			НомерСтроки = НомерСтроки + 1;
			ПредставлениеТовара = Строка(СтрокаТЧ.Номенклатура);
			Если ЕстьРеквизитТовара(МетаДок, "Характеристика") И ЗначениеЗаполнено(СтрокаТЧ.Характеристика) Тогда
				ПредставлениеТовара = ПредставлениеТовара + ", " + СтрокаТЧ.Характеристика;
			КонецЕсли;
			ОбластьСтрока.Параметры.НомерСтроки = НомерСтроки;
			ОбластьСтрока.Параметры.Товар       = ПредставлениеТовара;
			ОбластьСтрока.Параметры.Количество  = СтрокаТЧ.Количество;
			ОбластьСтрока.Параметры.ЕдиницаИзмерения = СтрокаТЧ.Номенклатура.ЕдиницаИзмерения;
			ТабДок.Вывести(ОбластьСтрока);
		КонецЦикла;
		
		// --- Итог
		Область = Макет.ПолучитьОбласть("Итог");
		Область.Параметры.КоличествоНаименований = НомерСтроки;
		ТабДок.Вывести(Область);
		
		// --- Подписи
		Область = Макет.ПолучитьОбласть("Подписи");
		Область.Параметры.Ответственный = ЗначениеРеквизита(Док, МетаДок, "Ответственный");
		Область.Параметры.ЗавСкладом    = ЗавСкладом(Док, МетаДок);
		ТабДок.Вывести(Область);
		
		// --- Причина списания (доработка относительно типовой формы)
		Область = Макет.ПолучитьОбласть("Причина");
		Область.Параметры.ПричинаСписания = ПричинаСписания(Док, МетаДок);
		ТабДок.Вывести(Область);
		
		// Чтобы БСП знала, какая часть документа к какому объекту относится
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабДок, НомерСтрокиНачало, ОбъектыПечати, ДокументСсылка);
		
	КонецЦикла;
	
	Возврат ТабДок;
	
КонецФункции

// Нарисованный макет «Макет», если он есть в обработке, иначе программный.
Функция ПолучитьМакетАкта()
	
	Если Метаданные().Макеты.Найти("Макет") <> Неопределено Тогда
		Возврат ПолучитьМакет("Макет");
	КонецЕсли;
	Возврат ПрограммныйМакет();
	
КонецФункции

// Строит макет с именованными областями в коде (те же области, что и в рисованном).
// Колонки: 1 - №, 2 - Товар / подписи, 3 - Количество, 4 - Ед. изм.
Функция ПрограммныйМакет()
	
	М = Новый ТабличныйДокумент;
	ШрифтОбычный = Новый Шрифт("Arial", 9);
	ШрифтЖирный  = Новый Шрифт("Arial", 10, Истина);
	ШрифтКрупный = Новый Шрифт("Arial", 14, Истина);
	Линия = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
	
	М.Область(, 1, , 1).ШиринаКолонки = 18;
	М.Область(, 2, , 2).ШиринаКолонки = 60;
	М.Область(, 3, , 3).ШиринаКолонки = 12;
	М.Область(, 4, , 4).ШиринаКолонки = 6;
	
	// Штрихкод: строки 1-4 (пустые, картинка кладётся при выводе)
	М.Область(1, , 4, ).Имя = "Штрихкод";
	
	// Заголовок: строка 5
	Ячейка = М.Область(5, 1, 5, 4);
	Ячейка.Объединить();
	ЗаполнитьПараметром(Ячейка, "ТекстЗаголовка", ШрифтКрупный);
	Ячейка.ГраницаСнизу = Линия;
	М.Область(5, , 5, ).ВысотаСтроки = 24;
	М.Область(5, , 5, ).Имя = "Заголовок";
	
	// Шапка: строки 6-9 (6 - отступ)
	ВывестиПодписьИЗначение(М, 7, "Организация:", "Организация", ШрифтОбычный, ШрифтЖирный);
	ВывестиПодписьИЗначение(М, 8, "Подразделение:", "Подразделение", ШрифтОбычный, ШрифтЖирный);
	ВывестиПодписьИЗначение(М, 9, "Склад:", "Склад", ШрифтОбычный, ШрифтЖирный);
	М.Область(6, , 9, ).Имя = "Шапка";
	
	// Шапка таблицы: строка 11 (10 - отступ)
	ЗаполнитьТекстом(М.Область(11, 1, 11, 1), "№", ШрифтЖирный);
	ЗаполнитьТекстом(М.Область(11, 2, 11, 2), "Товар", ШрифтЖирный);
	Ячейка = М.Область(11, 3, 11, 4);
	Ячейка.Объединить();
	ЗаполнитьТекстом(Ячейка, "Количество", ШрифтЖирный);
	ОбвестиРамкой(М.Область(11, 1, 11, 4), Линия);
	М.Область(11, 1, 11, 4).ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
	М.Область(10, , 11, ).Имя = "ШапкаТаблицы";
	
	// Строка таблицы: строка 12
	ЗаполнитьПараметром(М.Область(12, 1, 12, 1), "НомерСтроки", ШрифтОбычный);
	М.Область(12, 1, 12, 1).ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
	ЗаполнитьПараметром(М.Область(12, 2, 12, 2), "Товар", ШрифтОбычный);
	ЗаполнитьПараметром(М.Область(12, 3, 12, 3), "Количество", ШрифтОбычный);
	М.Область(12, 3, 12, 3).ГоризонтальноеПоложение = ГоризонтальноеПоложение.Право;
	ЗаполнитьПараметром(М.Область(12, 4, 12, 4), "ЕдиницаИзмерения", ШрифтОбычный);
	ОбвестиРамкой(М.Область(12, 1, 12, 4), Линия);
	М.Область(12, , 12, ).Имя = "Строка";
	
	// Итог: строки 13-14
	ЗаполнитьТекстом(М.Область(14, 1, 14, 1), "Всего наименований", ШрифтОбычный);
	ЗаполнитьПараметром(М.Область(14, 2, 14, 2), "КоличествоНаименований", ШрифтОбычный);
	М.Область(14, 1, 14, 4).ГраницаСнизу = Линия;
	М.Область(13, , 14, ).Имя = "Итог";
	
	// Подписи: строки 15-18
	ВывестиСтрокуПодписи(М, 16, "Ответственный", "Ответственный", ШрифтЖирный, ШрифтОбычный, Линия);
	ВывестиСтрокуПодписи(М, 18, "Зав.складом", "ЗавСкладом", ШрифтЖирный, ШрифтОбычный, Линия);
	М.Область(15, , 18, ).Имя = "Подписи";
	
	// Причина списания: строки 19-20, в рамке
	Ячейка = М.Область(20, 1, 20, 4);
	Ячейка.Объединить();
	Ячейка.Заполнение = ТипЗаполненияОбластиТабличногоДокумента.Шаблон;
	Ячейка.Текст = "Причина списания: [ПричинаСписания]";
	Ячейка.Шрифт = ШрифтЖирный;
	ОбвестиРамкой(Ячейка, Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 2));
	М.Область(20, , 20, ).ВысотаСтроки = 22;
	М.Область(19, , 20, ).Имя = "Причина";
	
	Возврат М;
	
КонецФункции

Процедура ВывестиПодписьИЗначение(М, НомерСтроки, Подпись, ИмяПараметра, ШрифтПодписи, ШрифтЗначения)
	ЗаполнитьТекстом(М.Область(НомерСтроки, 1, НомерСтроки, 1), Подпись, ШрифтПодписи);
	Ячейка = М.Область(НомерСтроки, 2, НомерСтроки, 4);
	Ячейка.Объединить();
	ЗаполнитьПараметром(Ячейка, ИмяПараметра, ШрифтЗначения);
КонецПроцедуры

Процедура ВывестиСтрокуПодписи(М, НомерСтроки, Подпись, ИмяПараметра, ШрифтПодписи, ШрифтФИО, Линия)
	ЗаполнитьТекстом(М.Область(НомерСтроки, 1, НомерСтроки, 1), Подпись, ШрифтПодписи);
	М.Область(НомерСтроки, 2, НомерСтроки, 2).ГраницаСнизу = Линия; // место для подписи
	Ячейка = М.Область(НомерСтроки, 3, НомерСтроки, 4);
	Ячейка.Объединить();
	ЗаполнитьПараметром(Ячейка, ИмяПараметра, ШрифтФИО);
КонецПроцедуры

Процедура ЗаполнитьТекстом(Ячейка, Текст, Шрифт)
	Ячейка.Текст = Текст;
	Ячейка.Шрифт = Шрифт;
КонецПроцедуры

Процедура ЗаполнитьПараметром(Ячейка, ИмяПараметра, Шрифт)
	Ячейка.Заполнение = ТипЗаполненияОбластиТабличногоДокумента.Параметр;
	Ячейка.Параметр = ИмяПараметра;
	Ячейка.Шрифт = Шрифт;
КонецПроцедуры

Процедура ОбвестиРамкой(Ячейка, Линия)
	Ячейка.Обвести(Линия, Линия, Линия, Линия);
КонецПроцедуры

// Картинка штрихкода через подсистему БСП «Генерация штрихкода».
// Если подсистемы нет или компонента недоступна - акт печатается без штрихкода.
Процедура ВывестиШтрихкод(ТабДок, ДокументСсылка, НомерСтрокиНачало)
	
	Попытка
		МодульГенерации = ОбщегоНазначения.ОбщийМодуль("ГенерацияШтрихкода");
		Параметры = МодульГенерации.ПараметрыГенерацииШтрихкода();
		Параметры.Ширина = 300;
		Параметры.Высота = 60;
		Параметры.ТипКода = 1; // EAN-13
		Параметры.ОтображатьТекст = Ложь;
		Параметры.Штрихкод = ШтрихкодEAN13(ДокументСсылка);
		Результат = МодульГенерации.ИзображениеШтрихкода(Параметры);
		Если Результат.Результат Тогда
			Рисунок = ТабДок.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Картинка);
			Рисунок.Картинка = Результат.Картинка;
			Рисунок.РазмерКартинки = РазмерКартинки.Пропорционально;
			Рисунок.Линия = Новый Линия(ТипЛинииРисункаТабличногоДокумента.НетЛинии);
			Рисунок.Расположить(ТабДок.Область(НомерСтрокиНачало, 2, НомерСтрокиНачало + 3, 2));
		КонецЕсли;
	Исключение
		// Штрихкод не обязателен для акта - печатаем без него
		ЗаписьЖурналаРегистрации("АктОСписании_кв99", УровеньЖурналаРегистрации.Предупреждение, , ДокументСсылка,
			"Не удалось сформировать штрихкод: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

// EAN-13: "2" (внутренний код) + 11 цифр номера документа + контрольная цифра.
Функция ШтрихкодEAN13(ДокументСсылка)
	
	Цифры = "";
	Номер = Строка(ДокументСсылка.Номер);
	Для Индекс = 1 По СтрДлина(Номер) Цикл
		Символ = Сред(Номер, Индекс, 1);
		Если СтрНайти("0123456789", Символ) > 0 Тогда
			Цифры = Цифры + Символ;
		КонецЕсли;
	КонецЦикла;
	Цифры = Прав("00000000000" + Цифры, 11);
	Код12 = "2" + Цифры;
	
	Сумма = 0;
	Для Индекс = 1 По 12 Цикл
		Цифра = Число(Сред(Код12, Индекс, 1));
		Сумма = Сумма + ?(Индекс % 2 = 0, Цифра * 3, Цифра);
	КонецЦикла;
	Контрольная = (10 - Сумма % 10) % 10;
	
	Возврат Код12 + Формат(Контрольная, "ЧН=0; ЧГ=0");
	
КонецФункции

// Номер без префикса информационной базы, как в типовых формах («ЦБ-109»).
Функция НомерНаПечать(Номер)
	Возврат ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(Номер, Истина, Истина);
КонецФункции

Функция ЗавСкладом(Док, МетаДок)
	
	Склад = ЗначениеРеквизита(Док, МетаДок, "Склад");
	Если Не ЗначениеЗаполнено(Склад) Тогда
		Возврат "";
	КонецЕсли;
	Если Метаданные.Справочники.Склады.Реквизиты.Найти("ТекущийОтветственный") <> Неопределено Тогда
		Возврат Склад.ТекущийОтветственный;
	КонецЕсли;
	Возврат "";
	
КонецФункции

// Причина: реквизит «ПричинаСписания», если он есть в документе; иначе комментарий;
// если и он пуст - статья расходов.
Функция ПричинаСписания(Док, МетаДок)
	
	Причина = ЗначениеРеквизита(Док, МетаДок, "ПричинаСписания");
	Если Не ЗначениеЗаполнено(Причина) Тогда
		Причина = ЗначениеРеквизита(Док, МетаДок, "Комментарий");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Причина) Тогда
		Причина = ЗначениеРеквизита(Док, МетаДок, "СтатьяРасходов");
	КонецЕсли;
	Возврат ?(ЗначениеЗаполнено(Причина), Причина, "не указана");
	
КонецФункции

// Значение реквизита документа, если такой реквизит есть в метаданных (иначе пустая строка).
// Так форма не упадёт, если в другой версии УТ реквизит назван иначе.
Функция ЗначениеРеквизита(Док, МетаДок, ИмяРеквизита)
	
	Если МетаДок.Реквизиты.Найти(ИмяРеквизита) <> Неопределено Тогда
		Возврат Док[ИмяРеквизита];
	КонецЕсли;
	Возврат "";
	
КонецФункции

Функция ЕстьРеквизитТовара(МетаДок, ИмяРеквизита)
	Возврат МетаДок.ТабличныеЧасти.Товары.Реквизиты.Найти(ИмяРеквизита) <> Неопределено;
КонецФункции

#КонецОбласти
