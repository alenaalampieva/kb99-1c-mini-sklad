#Область ОбработчикиСобытий

// Неделя 6 (замечание по неделе 5): RLS по складу.
// Модуль сеанса выполняется в привилегированном режиме, поэтому может прочитать
// регистр СкладыПользователей даже у пользователя без прав на этот регистр.
Процедура УстановкаПараметровСеанса(ТребуемыеПараметры)

	Если ТребуемыеПараметры = Неопределено
		Или ТребуемыеПараметры.Найти("ТекущийСклад") <> Неопределено Тогда
		ПараметрыСеанса.ТекущийСклад = СкладТекущегоПользователя();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Склад, закрепленный за текущим пользователем ИБ в регистре СкладыПользователей.
// Не закреплен - пустая ссылка: пользователь с ролью Кладовщик/Менеджер
// тогда не видит документов ни одного склада.
Функция СкладТекущегоПользователя()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СкладыПользователей.Склад КАК Склад
	|ИЗ
	|	РегистрСведений.СкладыПользователей КАК СкладыПользователей
	|ГДЕ
	|	СкладыПользователей.Пользователь = &Пользователь";
	Запрос.УстановитьПараметр("Пользователь", ИмяПользователя());

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Склад;
	КонецЕсли;

	Возврат Справочники.Склады.ПустаяСсылка();

КонецФункции

#КонецОбласти
