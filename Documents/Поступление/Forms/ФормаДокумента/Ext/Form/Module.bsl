#Область ОбработчикиКомандФормы

// Подбор номенклатуры (занятие 26, листинг 26.6).
// Форма выбора открывается подчиненной таблице Материалы (третий параметр - владелец).
// ЗакрыватьПриВыборе = Ложь - форма не закрывается, можно подбирать подряд;
// МножественныйВыбор = Истина - можно выделить несколько строк, придет массив.
&НаКлиенте
Процедура Подбор(Команда)

	ПараметрыФормы = Новый Структура("ЗакрыватьПриВыборе, МножественныйВыбор", Ложь, Истина);
	ОткрытьФорму("Справочник.Номенклатура.ФормаВыбора", ПараметрыФормы, Элементы.Материалы);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийТаблицыФормыМатериалы

// Результат подбора приходит в ОбработкаВыбора владельца формы выбора.
&НаКлиенте
Процедура МатериалыОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	Если ТипЗнч(ВыбранноеЗначение) = Тип("Массив") Тогда
		Для Каждого ВыбранныйЭлемент Из ВыбранноеЗначение Цикл
			ДобавитьНоменклатуру(ВыбранныйЭлемент);
		КонецЦикла;
	Иначе
		ДобавитьНоменклатуру(ВыбранноеЗначение);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыМатериалы

&НаКлиенте
Процедура МатериалыКоличествоПриИзменении(Элемент)

	СтрокаТабличнойЧасти = Элементы.Материалы.ТекущиеДанные;
	РаботаСДокументами.РассчитатьСумму(СтрокаТабличнойЧасти);

КонецПроцедуры

&НаКлиенте
Процедура МатериалыЦенаПриИзменении(Элемент)

	СтрокаТабличнойЧасти = Элементы.Материалы.ТекущиеДанные;
	РаботаСДокументами.РассчитатьСумму(СтрокаТабличнойЧасти);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Если позиция уже есть в таблице - увеличиваем количество на 1,
// иначе добавляем новую строку с количеством 1. Сумму пересчитываем.
&НаКлиенте
Процедура ДобавитьНоменклатуру(Номенклатура)

	Найденные = Объект.Материалы.НайтиСтроки(Новый Структура("Материал", Номенклатура));
	Если Найденные.Количество() > 0 Тогда
		СтрокаТабличнойЧасти = Найденные[0];
		СтрокаТабличнойЧасти.Количество = СтрокаТабличнойЧасти.Количество + 1;
	Иначе
		СтрокаТабличнойЧасти = Объект.Материалы.Добавить();
		СтрокаТабличнойЧасти.Материал = Номенклатура;
		СтрокаТабличнойЧасти.Количество = 1;
	КонецЕсли;

	РаботаСДокументами.РассчитатьСумму(СтрокаТабличнойЧасти);
	Элементы.Материалы.ТекущаяСтрока = СтрокаТабличнойЧасти.ПолучитьИдентификатор();
	Модифицированность = Истина;

КонецПроцедуры

#КонецОбласти
