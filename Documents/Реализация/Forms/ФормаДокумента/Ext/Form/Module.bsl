#Область ОбработчикиКомандФормы

// Подбор номенклатуры (занятие 26, листинг 26.6).
// Форма выбора открывается подчиненной таблице ПереченьНоменклатуры (третий параметр - владелец).
// ЗакрыватьПриВыборе = Ложь - форма не закрывается, можно подбирать подряд;
// МножественныйВыбор = Истина - можно выделить несколько строк, придет массив.
&НаКлиенте
Процедура Подбор(Команда)

	ПараметрыФормы = Новый Структура("ЗакрыватьПриВыборе, МножественныйВыбор", Ложь, Истина);
	ОткрытьФорму("Справочник.Номенклатура.ФормаВыбора", ПараметрыФормы, Элементы.ПереченьНоменклатуры);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийТаблицыФормыПереченьНоменклатуры

// Результат подбора приходит в ОбработкаВыбора владельца формы выбора.
&НаКлиенте
Процедура ПереченьНоменклатурыОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	Если ТипЗнч(ВыбранноеЗначение) = Тип("Массив") Тогда
		Для Каждого ВыбранныйЭлемент Из ВыбранноеЗначение Цикл
			ДобавитьНоменклатуру(ВыбранныйЭлемент);
		КонецЦикла;
	Иначе
		ДобавитьНоменклатуру(ВыбранноеЗначение);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПереченьНоменклатуры

// Книга Радченко, занятие 12: при выборе номенклатуры подставляем розничную цену
// из периодического регистра сведений "Цены" на дату документа и пересчитываем сумму.
&НаКлиенте
Процедура ПереченьНоменклатурыНоменклатураПриИзменении(Элемент)

	СтрокаТабличнойЧасти = Элементы.ПереченьНоменклатуры.ТекущиеДанные;
	СтрокаТабличнойЧасти.Цена = РаботаСоСправочниками.РозничнаяЦена(Объект.Дата, СтрокаТабличнойЧасти.Номенклатура);
	РаботаСДокументами.РассчитатьСумму(СтрокаТабличнойЧасти);

КонецПроцедуры

&НаКлиенте
Процедура ПереченьНоменклатурыКоличествоПриИзменении(Элемент)

	СтрокаТабличнойЧасти = Элементы.ПереченьНоменклатуры.ТекущиеДанные;
	РаботаСДокументами.РассчитатьСумму(СтрокаТабличнойЧасти);

КонецПроцедуры

&НаКлиенте
Процедура ПереченьНоменклатурыЦенаПриИзменении(Элемент)

	СтрокаТабличнойЧасти = Элементы.ПереченьНоменклатуры.ТекущиеДанные;
	РаботаСДокументами.РассчитатьСумму(СтрокаТабличнойЧасти);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Если позиция уже есть в таблице - увеличиваем количество на 1,
// иначе добавляем новую строку с количеством 1 и ценой из регистра "Цены". Сумму пересчитываем.
&НаКлиенте
Процедура ДобавитьНоменклатуру(Номенклатура)

	Найденные = Объект.ПереченьНоменклатуры.НайтиСтроки(Новый Структура("Номенклатура", Номенклатура));
	Если Найденные.Количество() > 0 Тогда
		СтрокаТабличнойЧасти = Найденные[0];
		СтрокаТабличнойЧасти.Количество = СтрокаТабличнойЧасти.Количество + 1;
	Иначе
		СтрокаТабличнойЧасти = Объект.ПереченьНоменклатуры.Добавить();
		СтрокаТабличнойЧасти.Номенклатура = Номенклатура;
		СтрокаТабличнойЧасти.Количество = 1;
		СтрокаТабличнойЧасти.Цена = РаботаСоСправочниками.РозничнаяЦена(Объект.Дата, Номенклатура);
	КонецЕсли;

	РаботаСДокументами.РассчитатьСумму(СтрокаТабличнойЧасти);
	Элементы.ПереченьНоменклатуры.ТекущаяСтрока = СтрокаТабличнойЧасти.ПолучитьИдентификатор();
	Модифицированность = Истина;

КонецПроцедуры

#КонецОбласти
