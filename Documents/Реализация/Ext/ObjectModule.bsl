#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

// Проведение реализации по трем регистрам:
//  - ОстаткиНоменклатуры (остатки) - расход количества со склада;
//  - ПартииНоменклатуры (остатки)  - списание партий по FIFO с расчетом себестоимости;
//  - Продажи (обороты)             - количество, выручка и себестоимость продажи.
//
// Остатки получаем запросом к виртуальной таблице "Остатки" ДО записи движений
// (на момент документа, не включая его самого), а не проверяем "минус" после записи.
//
Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	// 1. Готовим наборы записей. Записать() внутри проведения НЕ вызываем:
	//    движения запишет платформа после обработчика, а при Отказ = Истина
	//    вся транзакция откатится. Старые движения самого документа в остатки
	//    не попадают, т.к. остатки читаем на границу "Исключая" его момент времени.
	Движения.ОстаткиНоменклатуры.Записывать = Истина;
	Движения.ПартииНоменклатуры.Записывать = Истина;
	Движения.Продажи.Записывать = Истина;

	// 2. Управляемая блокировка: пока мы читаем остатки и пишем движения,
	//    другие документы не могут изменить остатки этих товаров на этом складе.
	ЗаблокироватьОстатки();

	// 3. Один пакетный запрос с временной таблицей:
	//    ВТ_Товары - товары документа (свернутые по номенклатуре);
	//    результат 2 - товары + остаток на складе (ЛЕВОЕ СОЕДИНЕНИЕ с виртуальной таблицей Остатки);
	//    результат 3 - остатки партий, упорядоченные по моменту времени партии (для FIFO).
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТЧ.Номенклатура КАК Номенклатура,
	|	СУММА(ТЧ.Количество) КАК Количество,
	|	СУММА(ТЧ.Сумма) КАК Сумма
	|ПОМЕСТИТЬ ВТ_Товары
	|ИЗ
	|	Документ.Реализация.ПереченьНоменклатуры КАК ТЧ
	|ГДЕ
	|	ТЧ.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ТЧ.Номенклатура
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Товары.Номенклатура КАК Номенклатура,
	|	ВТ_Товары.Количество КАК Количество,
	|	ВТ_Товары.Сумма КАК Сумма,
	|	ЕСТЬNULL(Остатки.КоличествоОстаток, 0) КАК Остаток
	|ИЗ
	|	ВТ_Товары КАК ВТ_Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиНоменклатуры.Остатки(
	|				&МоментВремени,
	|				Склад = &Склад
	|					И Номенклатура В
	|						(ВЫБРАТЬ
	|							ВТ_Товары.Номенклатура
	|						ИЗ
	|							ВТ_Товары)) КАК Остатки
	|		ПО ВТ_Товары.Номенклатура = Остатки.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Партии.Номенклатура КАК Номенклатура,
	|	Партии.Партия КАК Партия,
	|	Партии.КоличествоОстаток КАК КоличествоОстаток,
	|	Партии.СтоимостьОстаток КАК СтоимостьОстаток
	|ИЗ
	|	РегистрНакопления.ПартииНоменклатуры.Остатки(
	|			&МоментВремени,
	|			Склад = &Склад
	|				И Номенклатура В
	|					(ВЫБРАТЬ
	|						ВТ_Товары.Номенклатура
	|					ИЗ
	|						ВТ_Товары)) КАК Партии
	|
	|УПОРЯДОЧИТЬ ПО
	|	Партии.Партия.МоментВремени";

	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("Склад", Склад);
	// Остатки на момент документа, НЕ включая его самого.
	Запрос.УстановитьПараметр("МоментВремени", Новый Граница(МоментВремени(), ВидГраницы.Исключая));

	Результаты = Запрос.ВыполнитьПакет();
	ВыборкаТоваров = Результаты[1].Выбрать();
	ТаблицаПартий = Результаты[2].Выгрузить();

	// 4. Контроль остатков - только при оперативном проведении.
	//    Документ "задним числом" не знает, что проведено после него, поэтому
	//    его проверка по остаткам на свой момент ничего не гарантирует.
	КонтролироватьОстатки = (РежимПроведения = РежимПроведенияДокумента.Оперативный);

	Пока ВыборкаТоваров.Следующий() Цикл

		Если КонтролироватьОстатки И ВыборкаТоваров.Остаток < ВыборкаТоваров.Количество Тогда
			Отказ = Истина;
			СообщитьПользователю(СтрШаблон(
				НСтр("ru = 'Недостаточно товара ""%1"" на складе ""%2"". Остаток: %3, требуется: %4'"),
				ВыборкаТоваров.Номенклатура, Склад, ВыборкаТоваров.Остаток, ВыборкаТоваров.Количество));
		КонецЕсли;

		Если Отказ Тогда
			Продолжить; // собираем все ошибки, но движения уже не формируем
		КонецЕсли;

		// Регистр остатков: расход количества.
		Движение = Движения.ОстаткиНоменклатуры.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.Номенклатура = ВыборкаТоваров.Номенклатура;
		Движение.Склад = Склад;
		Движение.Количество = ВыборкаТоваров.Количество;

		// Регистр партий: FIFO.
		Себестоимость = СписатьПартииFIFO(ВыборкаТоваров.Номенклатура, ВыборкаТоваров.Количество, ТаблицаПартий);

		// Оборотный регистр: продажи.
		Движение = Движения.Продажи.Добавить();
		Движение.Период = Дата;
		Движение.Номенклатура = ВыборкаТоваров.Номенклатура;
		Движение.Клиент = Клиент;
		Движение.Мастер = Мастер;
		Движение.Количество = ВыборкаТоваров.Количество;
		Движение.Сумма = ВыборкаТоваров.Сумма;
		Движение.Себестоимость = Себестоимость;

	КонецЦикла;

	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	// Движения записываются платформой автоматически после ОбработкаПроведения (Записывать = Истина).

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Списывает количество товара с партий в порядке их поступления (FIFO)
// и возвращает себестоимость списанного.
//
Функция СписатьПартииFIFO(Номенклатура, КоличествоКСписанию, ТаблицаПартий)

	ОсталосьСписать = КоличествоКСписанию;
	Себестоимость = 0;

	// Строки таблицы уже упорядочены по моменту партии - самые старые первыми.
	СтрокиПартий = ТаблицаПартий.НайтиСтроки(Новый Структура("Номенклатура", Номенклатура));

	Для Каждого СтрокаПартии Из СтрокиПартий Цикл

		Если ОсталосьСписать <= 0 Тогда
			Прервать;
		КонецЕсли;
		Если СтрокаПартии.КоличествоОстаток <= 0 Тогда
			Продолжить;
		КонецЕсли;

		Списать = Мин(ОсталосьСписать, СтрокаПартии.КоличествоОстаток);

		Если Списать = СтрокаПартии.КоличествоОстаток Тогда
			// Партия уходит целиком - списываем всю ее стоимость (без ошибок округления).
			СтоимостьСписания = СтрокаПартии.СтоимостьОстаток;
		Иначе
			СтоимостьСписания = Окр(СтрокаПартии.СтоимостьОстаток / СтрокаПартии.КоличествоОстаток * Списать, 2);
		КонецЕсли;

		Движение = Движения.ПартииНоменклатуры.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.Номенклатура = Номенклатура;
		Движение.Склад = Склад;
		Движение.Партия = СтрокаПартии.Партия;
		Движение.Количество = Списать;
		Движение.Стоимость = СтоимостьСписания;

		СтрокаПартии.КоличествоОстаток = СтрокаПартии.КоличествоОстаток - Списать;
		СтрокаПартии.СтоимостьОстаток = СтрокаПартии.СтоимостьОстаток - СтоимостьСписания;

		Себестоимость = Себестоимость + СтоимостьСписания;
		ОсталосьСписать = ОсталосьСписать - Списать;

	КонецЦикла;

	Если ОсталосьСписать > 0 Тогда
		// Возможно только при неоперативном проведении: партий не хватило.
		СообщитьПользователю(СтрШаблон(
			НСтр("ru = 'Товар ""%1"": не хватило партий на %2 ед., себестоимость рассчитана не полностью.'"),
			Номенклатура, ОсталосьСписать));
	КонецЕсли;

	Возврат Себестоимость;

КонецФункции

Процедура ЗаблокироватьОстатки()

	Блокировка = Новый БлокировкаДанных;

	ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.ОстаткиНоменклатуры");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.ИсточникДанных = ПереченьНоменклатуры;
	ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Номенклатура", "Номенклатура");
	ЭлементБлокировки.УстановитьЗначение("Склад", Склад);

	ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.ПартииНоменклатуры");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.ИсточникДанных = ПереченьНоменклатуры;
	ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Номенклатура", "Номенклатура");
	ЭлементБлокировки.УстановитьЗначение("Склад", Склад);

	Блокировка.Заблокировать();

КонецПроцедуры

Процедура СообщитьПользователю(ТекстСообщения)

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ТекстСообщения;
	Сообщение.Сообщить();

КонецПроцедуры

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли
