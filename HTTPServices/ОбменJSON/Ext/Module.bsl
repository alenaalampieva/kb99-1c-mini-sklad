#Область ОбработчикиHTTPМетодов

// Неделя 6. Простой обмен JSON через HTTP-сервис (имитация внешней системы).
//
// GET  /hs/exchange/stock[?warehouse=<наименование склада>]
//      -> 200, {"date": ..., "warehouse": ..., "items": [{"code", "name", "warehouse", "quantity", "price"}]}
//
// POST /hs/exchange/receipt
//      тело: {"warehouse": "Основной", "comment": "...",
//             "items": [{"code": "000000001", "quantity": 5, "price": 100}]}
//      -> 201, {"result": "ok", "number": ..., "date": ..., "posted": true, "sum": ...}
//      -> 400, {"result": "error", "errors": [...]} - ошибки данных (неизвестный товар, склад, пустой список)
//
// Ссылки в JSON не передаем (ЗаписатьJSON их не умеет) - только коды и наименования.

Функция ОстаткиGET(Запрос)

	ИмяСклада = Запрос.ПараметрыЗапроса.Получить("warehouse");

	ЗапросДанных = Новый Запрос;
	ЗапросДанных.Текст =
	"ВЫБРАТЬ
	|	Остатки.Номенклатура.Код КАК Код,
	|	Остатки.Номенклатура.Наименование КАК Наименование,
	|	Остатки.Склад.Наименование КАК Склад,
	|	Остатки.КоличествоОстаток КАК Количество,
	|	ЕСТЬNULL(Цены.Цена, 0) КАК Цена
	|ИЗ
	|	РегистрНакопления.ОстаткиНоменклатуры.Остатки(, ) КАК Остатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Цены.СрезПоследних(&Дата, ) КАК Цены
	|		ПО Остатки.Номенклатура = Цены.Номенклатура
	|ГДЕ
	|	(&ВсеСклады
	|			ИЛИ Остатки.Склад.Наименование = &ИмяСклада)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Наименование";
	ЗапросДанных.УстановитьПараметр("Дата", ТекущаяДатаСеанса());
	ЗапросДанных.УстановитьПараметр("ВсеСклады", ИмяСклада = Неопределено);
	ЗапросДанных.УстановитьПараметр("ИмяСклада", ?(ИмяСклада = Неопределено, "", ИмяСклада));

	Товары = Новый Массив;
	Выборка = ЗапросДанных.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Товар = Новый Структура;
		Товар.Вставить("code", СокрЛП(Выборка.Код));
		Товар.Вставить("name", Выборка.Наименование);
		Товар.Вставить("warehouse", Выборка.Склад);
		Товар.Вставить("quantity", Выборка.Количество);
		Товар.Вставить("price", Выборка.Цена);
		Товары.Добавить(Товар);
	КонецЦикла;

	Ответ = Новый Структура;
	Ответ.Вставить("date", ТекущаяДатаСеанса());
	Ответ.Вставить("warehouse", ?(ИмяСклада = Неопределено, "все", ИмяСклада));
	Ответ.Вставить("items", Товары);

	Возврат ОтветJSON(200, Ответ);

КонецФункции

Функция ПоступлениеPOST(Запрос)

	// 1. Разбираем тело запроса.
	Попытка
		Данные = ПрочитатьТелоJSON(Запрос);
	Исключение
		Возврат ОтветОшибка(400, НСтр("ru = 'Тело запроса не является корректным JSON.'"));
	КонецПопытки;

	Ошибки = Новый Массив;
	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		Возврат ОтветОшибка(400, НСтр("ru = 'Ожидается JSON-объект.'"));
	КонецЕсли;

	// 2. Склад - по наименованию (по умолчанию "Основной").
	ИмяСклада = ?(Данные.Свойство("warehouse"), Данные.warehouse, "Основной");
	Склад = Справочники.Склады.НайтиПоНаименованию(ИмяСклада, Истина);
	Если Не ЗначениеЗаполнено(Склад) Тогда
		Ошибки.Добавить(СтрШаблон(НСтр("ru = 'Склад ""%1"" не найден.'"), ИмяСклада));
	КонецЕсли;

	// 3. Строки: все коды товаров ищем ОДНИМ запросом, а не по запросу на строку.
	СтрокиДанных = Неопределено;
	Если Не Данные.Свойство("items", СтрокиДанных) Или ТипЗнч(СтрокиДанных) <> Тип("Массив") Или СтрокиДанных.Количество() = 0 Тогда
		Ошибки.Добавить(НСтр("ru = 'Нет строк товаров (items).'"));
		СтрокиДанных = Новый Массив;
	КонецЕсли;

	Коды = Новый Массив;
	Для Каждого ДанныеСтроки Из СтрокиДанных Цикл
		Если ТипЗнч(ДанныеСтроки) = Тип("Структура") И ДанныеСтроки.Свойство("code") Тогда
			Коды.Добавить(ДанныеСтроки.code);
		КонецЕсли;
	КонецЦикла;
	СоответствиеТоваров = ТоварыПоКодам(Коды);

	ТаблицаСтрок = Новый Массив;
	НомерСтроки = 0;
	Для Каждого ДанныеСтроки Из СтрокиДанных Цикл
		НомерСтроки = НомерСтроки + 1;
		Если ТипЗнч(ДанныеСтроки) <> Тип("Структура") Или Не ДанныеСтроки.Свойство("code") Тогда
			Ошибки.Добавить(СтрШаблон(НСтр("ru = 'Строка %1: не указан код товара (code).'"), НомерСтроки));
			Продолжить;
		КонецЕсли;
		Товар = СоответствиеТоваров.Получить(ДанныеСтроки.code);
		Количество = ?(ДанныеСтроки.Свойство("quantity"), ДанныеСтроки.quantity, 0);
		Цена = ?(ДанныеСтроки.Свойство("price"), ДанныеСтроки.price, 0);
		Если Товар = Неопределено Тогда
			Ошибки.Добавить(СтрШаблон(НСтр("ru = 'Строка %1: товар с кодом ""%2"" не найден.'"), НомерСтроки, ДанныеСтроки.code));
		ИначеЕсли ТипЗнч(Количество) <> Тип("Число") Или Количество <= 0 Тогда
			Ошибки.Добавить(СтрШаблон(НСтр("ru = 'Строка %1: количество должно быть больше 0.'"), НомерСтроки));
		Иначе
			ТаблицаСтрок.Добавить(Новый Структура("Товар, Количество, Цена", Товар, Количество, Цена));
		КонецЕсли;
	КонецЦикла;

	Если Ошибки.Количество() > 0 Тогда
		Возврат ОтветОшибка(400, Ошибки);
	КонецЕсли;

	// 4. Создаем и проводим документ "Поступление".
	Документ = Документы.Поступление.СоздатьДокумент();
	Документ.Дата = ТекущаяДатаСеанса();
	Документ.Склад = Склад;
	Для Каждого ДанныеСтроки Из ТаблицаСтрок Цикл
		СтрокаТЧ = Документ.Материалы.Добавить();
		СтрокаТЧ.Материал = ДанныеСтроки.Товар;
		СтрокаТЧ.Количество = ДанныеСтроки.Количество;
		СтрокаТЧ.Цена = ДанныеСтроки.Цена;
		СтрокаТЧ.Сумма = ДанныеСтроки.Количество * ДанныеСтроки.Цена;
	КонецЦикла;

	Попытка
		Документ.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		ЗаписьЖурналаРегистрации("ОбменJSON", УровеньЖурналаРегистрации.Ошибка, , ,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат ОтветОшибка(400, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	ЗаписьЖурналаРегистрации("ОбменJSON", УровеньЖурналаРегистрации.Информация,
		Метаданные.Документы.Поступление, Документ.Ссылка,
		СтрШаблон(НСтр("ru = 'Из внешней системы загружено поступление № %1, строк: %2.'"),
			Документ.Номер, ТаблицаСтрок.Количество()));

	Ответ = Новый Структура;
	Ответ.Вставить("result", "ok");
	Ответ.Вставить("number", Документ.Номер);
	Ответ.Вставить("date", Документ.Дата);
	Ответ.Вставить("warehouse", ИмяСклада);
	Ответ.Вставить("posted", Документ.Проведен);
	Ответ.Вставить("sum", Документ.Материалы.Итог("Сумма"));

	Возврат ОтветJSON(201, Ответ);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Тело запроса -> структура (ПрочитатьJSON без соответствия возвращает Структуру/Массив).
Функция ПрочитатьТелоJSON(Запрос)

	Текст = Запрос.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Данные = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();
	Возврат Данные;

КонецФункции

// Код товара -> ссылка, одним запросом.
Функция ТоварыПоКодам(Коды)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Спр.Ссылка КАК Ссылка,
	|	Спр.Код КАК Код
	|ИЗ
	|	Справочник.Номенклатура КАК Спр
	|ГДЕ
	|	Спр.Код В(&Коды)
	|	И НЕ Спр.ЭтоГруппа";
	Запрос.УстановитьПараметр("Коды", Коды);

	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(СокрЛП(Выборка.Код), Выборка.Ссылка);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ОтветJSON(КодСостояния, Данные)

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(, Символы.Таб));
	ЗаписатьJSON(Запись, Данные);

	Ответ = Новый HTTPСервисОтвет(КодСостояния);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(Запись.Закрыть(), КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	Возврат Ответ;

КонецФункции

Функция ОтветОшибка(КодСостояния, Ошибки)

	Если ТипЗнч(Ошибки) <> Тип("Массив") Тогда
		Текст = Ошибки;
		Ошибки = Новый Массив;
		Ошибки.Добавить(Текст);
	КонецЕсли;
	Возврат ОтветJSON(КодСостояния, Новый Структура("result, errors", "error", Ошибки));

КонецФункции

#КонецОбласти
