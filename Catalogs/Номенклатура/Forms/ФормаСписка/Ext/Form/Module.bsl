// списком, чтобы услуги шли вперемешку с материалами, и скрываем линии сетки.
// Условное оформление задано в настройках динамического списка (реквизит "Список"):
//  - строки услуг (элементы внутри группы "Услуги") - сиреневый фон;
//  - группы - жирным шрифтом.
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	СписокСправочника = Элементы.Список;
	СписокСправочника.Отображение = ОтображениеТаблицы.Список;
	СписокСправочника.ВертикальныеЛинии = Ложь;
	СписокСправочника.ГоризонтальныеЛинии = Ложь;

КонецПроцедуры

