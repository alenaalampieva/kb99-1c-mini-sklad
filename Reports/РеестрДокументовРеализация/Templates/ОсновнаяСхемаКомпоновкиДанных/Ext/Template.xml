		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	Р.Дата КАК Дата,
	Р.Ссылка КАК Документ,
	Р.Склад КАК Склад,
	Р.Клиент КАК Клиент,
	Р.Мастер КАК Мастер,
	СУММА(ЕСТЬNULL(Т.Сумма, 0)) КАК Сумма
ИЗ
	Документ.Реализация КАК Р
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Реализация.ПереченьНоменклатуры КАК Т
		ПО (Т.Ссылка = Р.Ссылка)
ГДЕ
	Р.Проведен
СГРУППИРОВАТЬ ПО
	Р.Дата,
	Р.Ссылка,
	Р.Склад,
	Р.Клиент,
	Р.Мастер</query>
